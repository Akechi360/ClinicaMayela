# Supabase credentials (service role key, NOT anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Health check port (Render sets this automatically)
PORT=3000

# Dirección pública de la app (para el enlace de la ficha de ingreso que se envía a pacientes nuevos)
APP_URL=https://dra-mayela-gonzalez.vercel.app
